# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vv_dev

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long
JWT_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=development

# Vercel (for production deployment)
VERCEL_TOKEN=your-vercel-token
VERCEL_PROJECT_ID_POOLS=your-vercel-project-id
VERCEL_ORG_ID=your-vercel-org-id

# Health check URL (production)
PROD_HEALTH_URL=https://your-pools-api.vercel.app/api/health