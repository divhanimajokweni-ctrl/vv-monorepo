{
  "name": "ubuntu-pools-api",
  "version": "1.0.0",
  "description": "Ubuntu Pools API - REST API for pool management",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "lint": "eslint src/**/*.ts",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "health": "curl -f http://localhost:3001/api/health || exit 1"
  },
  "dependencies": {
    "@vv/shared-kernel": "workspace:*",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.2.0",
    "compression": "^1.7.4",
    "express-validator": "^7.0.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/node": "^20.12.7",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "supertest": "^6.3.4",
    "@types/supertest": "^6.0.2"
  }
}
