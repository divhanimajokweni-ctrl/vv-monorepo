# Database
# Get this from your PostgreSQL provider (e.g., Neon, Supabase, Railway)
DATABASE_URL=your_database_url_here
RESEND_API_KEY=your_resend_api_key_here

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Socket.io (for WebSocket connections)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Stitch (get from https://dashboard.stitch.com/developers/keys)
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
STITCH_ENV=sandbox
STITCH_REDIRECT_URI=http://localhost:3000/api/stitch/callback

# Bank Provider (default: stitch)
BANK_PROVIDER=stitch

# Observability
NEXT_PUBLIC_METRICS_ENABLED=true

# Error Tracking - Sentry (free tier: 10k events/month)
# Get your DSN from https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Cache - Upstash Redis (free tier: 10k requests/day)
# Get credentials from https://console.upstash.com
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# OpenClaw Integration (Executive Shadow)
# Set to 'true' to enable OpenClaw notifications
OPENCLAW_ENABLED=true
# Your OpenClaw Gateway URL
OPENCLAW_GATEWAY_URL=wss://claw.kilosessions.ai
# API key / gateway token for OpenClaw
OPENCLAW_API_KEY=your_openclaw_api_key_here
# HMAC signing secret for request integrity (falls back to OPENCLAW_API_KEY if not set)
OPENCLAW_SIGNING_SECRET=

Gemini_API_Key=your_gemini_api_key_here

# Anthropic Cloud Inference
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local inference (Ollama)
LOCAL_INFERENCE_ENDPOINT=http://localhost:11434
LOCAL_MODEL_NAME=gemma3:4b # edge devices (Jetson Orin Nano)
# LOCAL_MODEL_NAME=gemma3:27b # high-perf (RTX AI PC / DGX Spark)
# NeMoClaw policy guardrails (enterprise SafeGrid clients)
NEMOCLAW_ENABLED=false
NEMOCLAW_POLICY_PATH=./policies/safegrid-enterprise.yaml
NEMOCLAW_OFFLINE_MODE=true # never phone home with sensitive data
# Tier override (useful for development)
FORCE_INFERENCE_TIER=auto # local | cloud | auto