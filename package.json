{
  "name": "vv-monorepo",
  "version": "1.0.0",
  "description": "VV Monorepo for security testing pipeline",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "npx tsx packages/safestakes/src/simulator.ts",
    "test": "vitest run",
    "fixtures:generate": "node scripts/generate-fixtures.js",
    "replay": "node scripts/replay.js",
    "test:staging": "node scripts/test-staging.js",
    "deploy:attest": "node scripts/deploy-attest.js",
    "shadow:start": "tsx tools/shadow-evaluator/src/index.ts",
    "shadow:report": "tsx tools/shadow-evaluator/src/report.ts",
    "shadow:compare": "tsx tools/cli/src/vv-shadow-diverge.ts"
  },
  "dependencies": {
    "@kilocode/cli": "^7.2.24",
    "opencode-ai": "^1.14.25"
  },
  "devDependencies": {
    "express": "^4.18.0",
    "vitest": "^4.1.5"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
