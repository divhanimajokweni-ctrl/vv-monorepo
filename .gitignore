# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
!.env.example

# NEVER commit these sensitive files
*.env.local
*.env.production
*.env.development
credentials.json
service-account-key.json

# Clerk keys (if manually set)
CLERK_*

# Supabase
SUPABASE_*

# Plaid
PLAID_*

# API Keys - General
API_KEY*
api_key*
SECRET*
PRIVATE_*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.aider*

# Sentry Config File
.env.sentry-build-plugin
