      "@ubuntu/cache": ["packages/cache/src/index.ts"],
      "@ubuntu/ledger": ["packages/ledger/src/index.ts"],
      "@ubuntu/governance": ["packages/governance/src/index.ts"],
      "@ubuntu/villages": ["packages/villages/src/index.ts"],
      "@ubuntu/reputation": ["packages/reputation/src/index.ts"],
      "@ubuntu/credit": ["packages/credit/src/index.ts"],
      "@ubuntu/games": ["packages/games/src/index.ts"],
      "@ubuntu/lindiwe": ["packages/lindiwe/src/index.ts"],
      "@ubuntu/messaging": ["packages/messaging/src/index.ts"],
      "@ubuntu/sovereignty": ["packages/sovereignty/src/index.ts"],
      "@ubuntu/ui": ["packages/ui/src/index.ts"],
      "@ubuntu/observability": ["packages/observability/src/index.ts"],
