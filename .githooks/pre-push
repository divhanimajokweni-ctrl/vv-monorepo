#!/bin/sh
# Pre-push hook to check for large files

MAX_SIZE=50000000  # 50MB

while read oldrev newrev refname; do
    if [ "$refname" = "refs/heads/main" ]; then
        for commit in $(git rev-list "$oldrev".."$newrev"); do
            git tree=$(git rev-parse $commit^{tree})
            for obj in $(git ls-tree -r $tree | cut -f2 -d' '); do
                size=$(git cat-file -s $obj 2>/dev/null || echo 0)
                if [ "$size" -gt "$MAX_SIZE" ]; then
                    echo "Error: Large file exceeded 50MB limit"
                    exit 1
                fi
            done
        done
    fi
done

exit 0
