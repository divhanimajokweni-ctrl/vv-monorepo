#!/bin/sh
# Pre-push hook to enforce repository rules

# Protected branches that require force push protection
PROTECTED_BRANCHES="main ubuntu-pools-v2"

# Check for force pushes to protected branches
while read local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main|refs/heads/ubuntu-pools-v2)
            # Check if this is a force push
            if [ "$remote_sha" != "0000000000000000000000000000000000000000" ] && [ "$local_sha" != "$remote_sha" ]; then
                # Check if local is not ancestor of remote (force push detection)
                git merge-base --is-ancestor "$local_sha" "$remote_sha" 2>/dev/null
                if [ $? -ne 0 ]; then
                    echo "ERROR: Force push to $remote_ref is blocked by ruleset."
                    echo "Protected branches cannot be force pushed."
                    echo "Please use a pull request instead."
                    exit 1
                fi
            fi
            ;;
    esac
done

exit 0